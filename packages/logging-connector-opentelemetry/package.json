{
	"name": "@twin.org/logging-connector-opentelemetry",
	"version": "0.10.1-next.0",
	"description": "Forwards log events to OpenTelemetry-compatible observability pipelines via OTLP.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-logging.git",
		"directory": "packages/logging-connector-opentelemetry"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@opentelemetry/api-logs": "0.221.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.221.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-logs": "0.221.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/logging-models": "0.10.1-next.0",
		"@twin.org/nameof": "next"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "26.1.2",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"logging",
		"opentelemetry",
		"otel",
		"otlp",
		"logs",
		"observability",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-logging/issues"
	},
	"homepage": "https://twindev.org"
}
